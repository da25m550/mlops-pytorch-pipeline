# =============================================================================
# .gitignore for mlops-pytorch-pipeline
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
*.pyo

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── ML artefacts (never commit large binaries to Git) ────────────────────────
# Dataset cache — download at runtime
data/
*.tar.gz
*.tar
*.zip

# Model checkpoints — stored in PVC / object storage
checkpoints/
*.pt
*.pth
*.ckpt
*.bin
*.safetensors

# TensorBoard logs
runs/
logs/
*.tfevents.*

# ── Testing & coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore Dockerfiles themselves, but ignore build context artefacts
.dockerignore

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
.env.*
secrets/
*.pem
*.key
*.crt
kubeconfig
*.kubeconfig

# ── Misc ──────────────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
.cache/
